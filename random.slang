     * limitations under the License.
     *
     * For additional information about the PCG random number generation scheme,
     * including its license and other licensing options, visit
     *
     *       http://www.pcg-random.org
     */
    public struct PCG32 : IRandom {
        uint64_t state;
        uint64_t inc;

        // Init with default seed
        public __init() {
            state = 0x853c49e6748fea9bULL;
            inc = 0xda3e39cb94b95bdbULL;
        }

        public __init(uint64_t initstate, uint64_t initseq) {
            state = 0U;
            inc = (initseq << uint64_t(1)) | uint64_t(1);
            next_uint();
            state += initstate;
            next_uint();
        }

        // Generate a uniformly distributed 32-bit random number
        [mutating] public uint32_t next_uint() {
            const uint64_t oldstate = state;
            state = oldstate * 0x5851f42d4c957f2dULL + inc;
            const uint32_t xorshifted = uint32_t(((oldstate >> 18ULL) ^ oldstate) >> 27ULL);
            const uint32_t rot = uint32_t(oldstate >> 59ULL);
            return (xorshifted >> rot) | (xorshifted << ((~rot + 1u) & 31u));
        }

        // Generate a single precision floating point value on the interval [0, 1)
        [mutating] public float next_float() {
            // Trick from MTGP: generate an uniformly distributed
            // double precision number in [1,2) and subtract 1.
            return bit_cast<float>((next_uint() >> 9u) | 0x3f800000u) - 1.0f;
        }

        [mutating] public f32v2 next_float2() { return f32v2(next_float(), next_float()); }
        [mutating] public f32v3 next_float3() { return f32v3(next_float(), next_float(), next_float()); }
        [mutating] public f32v4 next_float4() { return f32v4(next_float(), next_float(), next_float(), next_float()); }

        // Generate a double precision floating point value on the interval [0, 1)
        [mutating] public double next_double() {
            // Trick from MTGP: generate an uniformly distributed
            // double precision number in [1,2) and subtract 1.
            const uint64_t u = (uint64_t(next_uint()) << 20ULL) | (uint64_t(next_uint()) >> 12ULL) | 0x3ff0000000000000ULL;
            return bit_cast<double>(u) - 1.0;
        }

        [mutating] public f64v2 next_double2() { return f64v2(next_double(), next_double()); }
        [mutating] public f64v3 next_double3() { return f64v3(next_double(), next_double(), next_double()); }
        [mutating] public f64v4 next_double4() { return f64v4(next_double(), next_double(), next_double(), next_double()); }
    };

    // https://stegu.github.io/webgl-noise/webdemo/
    public float3 noise3D(float3 p) {
        return p.xxx;
    }

    public float noise1D(float3 p) {
        return p.x;
    }
}
